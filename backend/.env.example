# Copiez ce fichier en « .env » à la racine du dossier backend/,
# puis renseignez les deux valeurs ci-dessous.
#
#   cp .env.example .env
#
# Le fichier .env est exclu du dépôt Git (voir .gitignore) : il ne doit
# jamais être versionné, car il contient les identifiants de la base et
# la clé de signature des tokens.

# Chaîne de connexion MongoDB Atlas.
# Format : mongodb+srv://<utilisateur>:<motdepasse>@<cluster>.mongodb.net/<base>?retryWrites=true&w=majority
MONGODB_URI=

# Clé secrète utilisée pour signer et vérifier les tokens JWT.
# N'importe quelle chaîne longue et aléatoire convient.
# Pour en générer une : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port d'écoute du serveur (facultatif).
# Laissez vide ou omettez cette ligne pour utiliser 4000, valeur attendue par le front-end.
PORT=4000
